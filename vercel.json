{
  "cleanUrls": true,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "server-v2.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "server-v2.js"
    },

    {
      "source": "/product",
      "destination": "/Public/Src/views/Product.html"
    },
    {
      "source": "/home",
      "destination": "/Public/Src/views/WelcomePage.html"
    },
    {
      "source": "/",
      "destination": "/Public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/Public/$1"
    }
  ]
}
